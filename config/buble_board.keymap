// This file was generated from a template. Edit it to match your keyboard.
// See https://zmk.dev/docs/development/hardware-integration/new-shield for more instructions.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    // Define a default keymap here.
    // See https://zmk.dev/docs/development/hardware-integration/new-shield#default-keymap.
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
                &kp ESC    &kp F1    &kp F2    &kp F3  &kp F4  &kp F5     &kp F6  &kp F7  &kp F8     &kp F9    &kp F10   &kp F11    &kp F12     &kp PSCRN  &kp SCROLLLOCK  &kp PAUSE_BREAK  &to 1
                &kp GRAVE  &kp N1    &kp N2    &kp N3  &kp N4  &kp N5     &kp N6  &kp N7  &kp N8     &kp N9    &kp N0    &kp MINUS  &kp EQUAL              &kp BSPC        &kp INS          &kp HOME   &kp KP_NUMLOCK  &kp FSLH  &kp STAR  &kp MINUS
                &kp TAB    &kp Q     &kp W     &kp E   &kp R   &kp T      &kp Y   &kp U   &kp I      &kp O     &kp P     &kp LBKT   &kp RBKT               &kp BSLH        &kp DEL          &kp END    &kp N7          &kp N8    &kp N9    &kp PLUS
                &kp CAPS   &kp A     &kp S     &kp D   &kp F   &kp G      &kp H   &kp J   &kp K      &kp L     &kp SEMI  &kp APOS                          &kp ENTER       &kp PG_UP        &kp PG_DN  &kp N4          &kp N5    &kp N6
                &kp LSHFT  &kp Z     &kp X     &kp C   &kp V   &kp B      &kp N   &kp M   &kp COMMA  &kp DOT   &kp FSLH                                    &kp RSHFT       &kp UP                      &kp N1          &kp N2    &kp N3    &kp RET
                &kp LCTRL  &kp LGUI  &kp LALT                  &kp SPACE                  &kp RGUI   &kp RALT                       &kp C_MENU  &kp RCTRL  &kp LEFT        &kp DOWN         &kp RIGHT  &kp N0                    &kp DOT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
        control_layer {
            display-name = "Control";
            bindings = <
                &none  &bootloader  &bt BT_CLR_ALL  &out OUT_TOG  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &to 0
                &none  &none        &none           &none         &none  &none  &none  &none  &none  &none  &none  &none  &none         &none  &none  &none  &none  &none  &none  &none
                &none  &none        &none           &none         &none  &none  &none  &none  &none  &none  &none  &none  &none         &none  &none  &none  &none  &none  &none  &none
                &none  &none        &none           &none         &none  &none  &none  &none  &none  &none  &none  &none                &none  &none  &none  &none  &none  &none
                &none  &none        &none           &none         &none  &none  &none  &none  &none  &none  &none                       &none  &none         &none  &none  &none  &none
                &none  &none        &none                                &none                &none  &none                &none  &none  &none  &none  &none  &none         &none
            >;
            sensor-bindings = <&none>;
        };
    };
};
